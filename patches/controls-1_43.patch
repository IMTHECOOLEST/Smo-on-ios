@@ -0,0 +1,35 @@
+// Physical controllers on iOS: one of two backends reads them (DmController.m on GameController, the default; DmSDL3Pad.c on SDL3, when the app was built with it), and both report to DmGamepad.m through
+// these calls. Buttons and sticks go out as the host's input bits (dm_input.h); motion and rumble go straight to the host (dm_pad_motion_set, dm_rumble_attach).
+//
+// Environment (Documents/env.txt):
+//   DM_PAD_BACKEND=auto|gc|sdl3   auto (the default) and gc: GameController. sdl3: SDL3, when the app was built with it (else GameController, with a log line)
+//   DM_PAD_FACE=xbox|nintendo     the face keys' meaning, see dm_pad_core.h (xbox by default)
+//   DM_MOTION=0                   leave a controller's gyro and accelerometer off
+//   DM_MOTION_AXES=x,-y,-z        the axis map from the controller's frame to the Switch's, see dm_pad_core.h
+//   DM_MOTION_LOG=1               log a sample of the motion twice a second (to check the axes on a real device)
+//   DM_RUMBLE=0                   no rumble
+//   DM_RUMBLE_GAIN=1.0            rumble strength (0..2; the result is limited to full strength)
+#pragma once
+#include <stdint.h>
+
+typedef struct { uint64_t buttons; int32_t lx, ly, rx, ry; } dm_ctrl_state;   // buttons: dm_input.h bits; sticks ±32767, up positive
+typedef struct {
+    void (*state)(const dm_ctrl_state *s);   // the physical controller's buttons and sticks changed (any thread)
+    void (*presence)(int connected);         // at least one physical controller is connected / none is (any thread)
+} dm_ctrl_ops;
+
+// Start reading controllers (main thread, once). Chooses the backend and logs which
+void dm_ctrl_start(const dm_ctrl_ops *ops);
+
+// ---- for the backends ----
+int dm_ctrl_face_layout(void);                                            // DM_FACE_XBOX / DM_FACE_NINTENDO
+int dm_ctrl_motion_enabled(void);
+int dm_ctrl_rumble_enabled(void);
+float dm_ctrl_rumble_gain(void);
+// One motion sample in frame D (x right, y toward the top edge, z out of the face; acceleration as the force the sensor feels, in G; angular velocity in rad/s): mapped to the Switch frame and given to the host
+void dm_ctrl_motion(const float force_g[3], const float gyro_rps[3]);
+void dm_ctrl_motion_off(void);
+
+// SDL3 backend (DmSDL3Pad.c). dm_sdl3_available is 0 when the app was built without SDL3; dm_sdl3_start then does nothing and returns 0. A 1 means the backend runs (it owns the controllers)
+int dm_sdl3_available(void);
+int dm_sdl3_start(const dm_ctrl_ops *ops);
diff -ruN orig/nxnative-main/dm/ios/Sources/dm_pad_core.c nx/nxnative-main/dm/ios/Sources/dm_pad_core.c
--- orig/nxnative-main/dm/ios/Sources/dm_pad_core.c	1970-01-01 00:00:00.000000000 +0000
+++ nx/nxnative-main/dm/ios/Sources/dm_pad_core.c	2026-10-24 06:42:25.284969022 +0000
@@ -0,0 +1,88 @@
+// Controller core (see dm_pad_core.h): no Apple or SDL headers.
+#include "dm_pad_core.h"
+#include <math.h>
+#include <strings.h>
+#include <string.h>
+
+// dm_input.h's DM_BTN_A..Y, repeated as plain bit numbers so this file includes nothing from the host
+enum { BIT_A = 0, BIT_B = 1, BIT_X = 2, BIT_Y = 3 };
+
+int dm_pad_face_parse(const char *s, int dflt) {
+    if (!s) return dflt;
+    if (!strcasecmp(s, "xbox")) return DM_FACE_XBOX;
+    if (!strcasecmp(s, "nintendo") || !strcasecmp(s, "switch") || !strcasecmp(s, "position")) return DM_FACE_NINTENDO;
+    return dflt;
+}
+
+uint64_t dm_pad_face_buttons(int layout, int south, int east, int west, int north) {
+    uint64_t m = 0;
+    if (layout == DM_FACE_NINTENDO) {   // A right, B bottom, X top, Y left
+        if (south) m |= 1ull << BIT_B;
+        if (east)  m |= 1ull << BIT_A;
+        if (west)  m |= 1ull << BIT_Y;
+        if (north) m |= 1ull << BIT_X;
+    } else {                            // Xbox: A bottom, B right, X left, Y top
+        if (south) m |= 1ull << BIT_A;
+        if (east)  m |= 1ull << BIT_B;
+        if (west)  m |= 1ull << BIT_X;
+        if (north) m |= 1ull << BIT_Y;
+    }
+    return m;
+}
+
+int32_t dm_pad_axis(float v) {
+    if (isnan(v)) return 0;
+    if (v > 1.f) v = 1.f;
+    if (v < -1.f) v = -1.f;
+    return (int32_t)lrintf(v * 32767.f);
+}
+
+const dm_axmap DM_AXMAP_DEFAULT = {{0, 1, 2}, {1, -1, -1}};
+
+int dm_axmap_parse(const char *s, dm_axmap *out) {
+    if (!s || !out) return 0;
+    char b[32]; size_t n = 0;
+    for (const char *p = s; *p; p++) {   // drop spaces
+        if (*p == ' ' || *p == '\t') continue;
+        if (n + 1 >= sizeof b) return 0;
+        b[n++] = *p;
+    }
+    b[n] = 0;
+    int commas = 0; for (const char *p = b; *p; p++) commas += *p == ',';
+    if (commas != 2) return 0;           // strtok_r would skip empty tokens: "x,,y,z" must not pass
+    dm_axmap m; int used = 0, k = 0;
+    char *save = NULL;
+    for (char *tok = strtok_r(b, ",", &save); tok; tok = strtok_r(NULL, ",", &save), k++) {
+        if (k >= 3) return 0;
+        int sgn = 1; const char *c = tok;
+        if (*c == '-') { sgn = -1; c++; } else if (*c == '+') c++;
+        int a;
+        if (*c == 'x' || *c == 'X') a = 0; else if (*c == 'y' || *c == 'Y') a = 1; else if (*c == 'z' || *c == 'Z') a = 2; else return 0;
+        if (c[1]) return 0;              // nothing after the axis letter
+        if (used & (1 << a)) return 0;   // each axis once
+        used |= 1 << a; m.src[k] = (int8_t)a; m.sgn[k] = (int8_t)sgn;
+    }
+    if (k != 3) return 0;
+    *out = m; return 1;
+}
+
+void dm_axmap_apply(const dm_axmap *m, const float in[3], float out[3]) {
+    float t[3] = {in[0], in[1], in[2]};   // in and out may be the same array
+    for (int i = 0; i < 3; i++) out[i] = (float)m->sgn[i] * t[m->src[i]];
+}
+
+#define HD_FMIN 40.0f
+#define HD_FMAX 1252.0f
+static float clamp01(float v) { return isnan(v) ? 0.f : v < 0.f ? 0.f : v > 1.f ? 1.f : v; }
+static float sharp_of(float f) {
+    if (isnan(f) || f < HD_FMIN) f = HD_FMIN;
+    if (f > HD_FMAX) f = HD_FMAX;
+    return clamp01(log2f(f / HD_FMIN) / log2f(HD_FMAX / HD_FMIN));
+}
+
+void dm_hd_to_haptic(float amp, float freq_hz, float *intensity, float *sharpness) {
+    if (intensity) *intensity = clamp01(amp);
+    if (sharpness) *sharpness = sharp_of(freq_hz);
+}
+
+uint16_t dm_hd_to_u16(float amp) { return (uint16_t)lrintf(clamp01(amp) * 65535.f); }
diff -ruN orig/nxnative-main/dm/ios/Sources/dm_pad_core.h nx/nxnative-main/dm/ios/Sources/dm_pad_core.h
--- orig/nxnative-main/dm/ios/Sources/dm_pad_core.h	1970-01-01 00:00:00.000000000 +0000
+++ nx/nxnative-main/dm/ios/Sources/dm_pad_core.h	2026-10-24 06:42:25.285224279 +0000
@@ -0,0 +1,37 @@
+// Controller core: the parts of the physical-controller path that need no Apple or SDL headers, so they are unit-tested on any machine (dm/host/tests/t_pad_core.c).
+// Used by DmController.m (GameController backend), DmSDL3Pad.c (SDL3 backend) and DmGamepad.m.
+#pragma once
+#include <stdint.h>
+
+// ---- Face buttons ----
+// The face buttons arrive by position (south = bottom, east = right, west = left, north = top), which is how both GameController and SDL3 name them.
+//   DM_FACE_XBOX     (the default) Xbox layout: A bottom, B right, X left, Y top. The game's A is the bottom key, B the right one, X the left one and Y the top one.
+//   DM_FACE_NINTENDO Nintendo positions, what the app did before: A right, B bottom, X top, Y left.
+// The touch gamepad keeps the Nintendo positions in both cases (DmGamepad.m); this only decides what a physical controller's keys mean.
+enum { DM_FACE_XBOX = 0, DM_FACE_NINTENDO = 1 };
+// "xbox" / "nintendo" (also "switch", "position"), any case; anything else (and NULL) gives dflt
+int dm_pad_face_parse(const char *s, int dflt);
+// The game's A / B / X / Y bits (dm_input.h DM_BTN_A..Y: bits 0..3) for the four keys by position
+uint64_t dm_pad_face_buttons(int layout, int south, int east, int west, int north);
+
+// ---- Sticks ----
+// -1..1 → -32767..32767 (the host's range). Clamps; NaN → 0
+int32_t dm_pad_axis(float v);
+
+// ---- Motion axes ----
+// The host's six-axis state uses the Switch controller frame, in which a controller lying flat, face up, reads acceleration (0, 0, -1) G (hle_hid.c): x to the right, y toward the player, z down into the body.
+// The front ends first bring a sample to the frame D that SDL3 uses (x right, y toward the top edge / away from the player, z out of the face), with acceleration as the force the sensor feels
+// (flat face up: (0, 0, +1) G; GameController reports the gravity vector instead, which is the negative: DmController.m negates it). D → Switch frame is a half turn about x: (x, -y, -z), for acceleration and
+// angular velocity alike. An axis map says it per output axis: out[i] = sgn[i] * in[src[i]]. DM_MOTION_AXES (Documents/env.txt) replaces the default if a controller's axes turn out different on a real device.
+typedef struct { int8_t src[3]; int8_t sgn[3]; } dm_axmap;
+extern const dm_axmap DM_AXMAP_DEFAULT;   // "x,-y,-z"
+// "x,-y,-z": three tokens, each x, y or z with an optional + or - sign, every axis exactly once (spaces are ignored). Returns 1 and fills out, or 0 and leaves out alone
+int dm_axmap_parse(const char *s, dm_axmap *out);
+void dm_axmap_apply(const dm_axmap *m, const float in[3], float out[3]);
+
+// ---- HD rumble ----
+// A Switch vibration value holds two bands, each an amplitude 0..1 and a frequency in Hz (40..1252; the defaults are 160 Hz low and 320 Hz high).
+// A Core Haptics event has an intensity and a sharpness, both 0..1: the band's amplitude and its frequency on a log scale over 40..1252 Hz.
+void dm_hd_to_haptic(float amp, float freq_hz, float *intensity, float *sharpness);
+// Amplitude 0..1 → 0..65535 (SDL_RumbleGamepad's scale)
+uint16_t dm_hd_to_u16(float amp);
